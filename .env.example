# codestats config. Copy to .env in the dir you run codestats from,
# or point CODESTATS_ENV_FILE at a file elsewhere. Nothing here is
# required -- these are the defaults. A real env var always wins over
# a value in this file.

# output filename for --pdf when none is given
CODESTATS_DEFAULT_PDF_FILENAME=codestats_report.pdf

# assumed MB per worker process, caps auto-detected parallelism
CODESTATS_WORKER_MEMORY_MB=300

# below this many files, skip the worker pool and just scan sequentially
CODESTATS_MIN_FILES_FOR_PARALLEL=1000

# extra dir names to skip, comma separated, on top of the built-in list
CODESTATS_EXTRA_IGNORE_DIRS=

# default --sort-by: code, lines, files, comment, or blank
CODESTATS_DEFAULT_SORT_BY=code

# how many project roots --projects shows at once
CODESTATS_MAX_PROJECTS_DISPLAYED=7

# exact path for the cache DB. Unset = auto-named file under the cache
# dir below, keyed by a hash of the repo path (nothing written inside
# the repo, different repos never collide).
# CODESTATS_CACHE_FILE=.codestats_cache.db

# base dir for that auto-named cache file, if CACHE_FILE isn't set.
# Default: C:\tmp on Windows, OS temp dir elsewhere.
# CODESTATS_CACHE_DIR=C:\tmp

# point codestats at a .env file elsewhere. Only works as a real env
# var (can't be set from inside a .env file, obviously).
# CODESTATS_ENV_FILE=/path/to/your/codestats.env
